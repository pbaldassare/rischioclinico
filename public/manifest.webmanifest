{
  "id": "/app",
  "name": "Rischio clinico",
  "short_name": "Rischio",
  "description": "Segnalazioni, FDR, sinistri ed eventi sentinella per le Aziende Sanitarie.",
  "lang": "it",
  "dir": "ltr",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#F0F3F5",
  "theme_color": "#F0F3F5",
  "prefer_related_applications": false,
  "categories": ["medical", "business", "productivity"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nuova segnalazione",
      "short_name": "Nuova",
      "url": "/app/nuova",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]}
